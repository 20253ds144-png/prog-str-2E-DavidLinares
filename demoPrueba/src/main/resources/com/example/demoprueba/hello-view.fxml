<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="250.0" prefWidth="357.0" spacing="20.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demoprueba.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <GridPane prefHeight="143.0" prefWidth="361.0">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
     </columnConstraints>
     <rowConstraints>
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
         <PasswordField fx:id="txtPassword" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         <Button mnemonicParsing="false" onAction="#onLoginClick" text="Ingresar" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Button>
         <Label text="Correo:" textFill="WHITE">
            <font>
               <Font name="Consolas" size="17.0" />
            </font>
         </Label>
         <Label alignment="CENTER" layoutX="10.0" layoutY="24.0" text="Contraseña:" textAlignment="CENTER" textFill="WHITE" GridPane.rowIndex="1">
            <font>
               <Font name="Consolas" size="17.0" />
            </font>
         </Label>
         <TextField fx:id="txtUsuario" GridPane.columnIndex="1" />
      </children>
   </GridPane>

    <Label fx:id="welcomeText" />
   <Label fx:id="lblMensaje" textFill="RED" />
</VBox>
